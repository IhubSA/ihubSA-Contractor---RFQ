import { serve } from 'https://deno.land/std@0.168.0/http/server.ts';

// Resend API Key from environment
const RESEND_API_KEY = Deno.env.get('RESEND_API_KEY');

const handler = async (req: Request): Promise<Response> => {
  // Only accept POST requests
  if (req.method !== 'POST') {
    return new Response(JSON.stringify({ error: 'Method not allowed' }), {
      status: 405,
      headers: { 'Content-Type': 'application/json' },
    });
  }

  try {
    const payload = await req.json();
    const {
      submissionId,
      rfqId,
      rfqName,
      refCode,
      contractorName,
      contractorEmail,
      companyName,
    } = payload;

    // Validate required fields
    if (!submissionId || !contractorEmail || !rfqName || !companyName) {
      return new Response(
        JSON.stringify({ error: 'Missing required fields' }),
        { status: 400, headers: { 'Content-Type': 'application/json' } }
      );
    }

    // Format the email HTML
    const emailHtml = `
      <html>
        <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
          <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
            <!-- Header -->
            <div style="background-color: #1a73e8; color: white; padding: 20px; border-radius: 4px 4px 0 0;">
              <h1 style="margin: 0; font-size: 24px;">Application Received ✓</h1>
            </div>

            <!-- Body -->
            <div style="background-color: #f9f9f9; padding: 20px; border-left: 4px solid #1a73e8;">
              <p>Hello <strong>${contractorName}</strong>,</p>

              <p>Thank you for submitting your application to <strong>${companyName}</strong>.</p>

              <div style="background-color: white; padding: 15px; border-radius: 4px; margin: 20px 0; border: 1px solid #e0e0e0;">
                <h3 style="margin-top: 0; color: #1a73e8;">Application Details</h3>
                <p><strong>RFQ:</strong> ${rfqName}</p>
                <p><strong>Reference Code:</strong> ${refCode}</p>
                <p><strong>Submission ID:</strong> ${submissionId}</p>
                <p><strong>Submitted:</strong> ${new Date().toLocaleString()}</p>
              </div>

              <p>Your application has been successfully received and recorded. ${companyName} will review your submission and may contact you if they require any additional information.</p>

              <p><strong>Next Steps:</strong></p>
              <ul>
                <li>Keep this email for your records</li>
                <li>Watch your inbox for updates from ${companyName}</li>
                <li>If you have any questions, contact ${companyName} directly</li>
              </ul>

              <p style="color: #666; font-size: 14px; margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
                This is an automated confirmation email. Please do not reply to this email.
              </p>
            </div>

            <!-- Footer -->
            <div style="background-color: #f0f0f0; padding: 15px; border-radius: 0 0 4px 4px; font-size: 12px; color: #666; text-align: center;">
              <p style="margin: 0;">Sent by iHubSA RFQ Hub</p>
            </div>
          </div>
        </body>
      </html>
    `;

    // Send email via Resend
    const response = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${RESEND_API_KEY}`,
      },
      body: JSON.stringify({
        from: 'RFQ Hub <noreply@public-rfq-hub.co.za>',
        to: contractorEmail,
        subject: `Application Confirmation: ${rfqName} (${refCode})`,
        html: emailHtml,
        reply_to: 'admin@public-rfq-hub.co.za',
      }),
    });

    const result = await response.json();

    if (!response.ok) {
      console.error('Resend API error:', result);
      return new Response(
        JSON.stringify({ error: 'Failed to send email', details: result }),
        { status: 500, headers: { 'Content-Type': 'application/json' } }
      );
    }

    console.log('✅ Confirmation email sent:', result.id);

    return new Response(
      JSON.stringify({ success: true, emailId: result.id }),
      { status: 200, headers: { 'Content-Type': 'application/json' } }
    );
  } catch (err) {
    console.error('Error in send-application-confirmation:', err);
    return new Response(
      JSON.stringify({ error: 'Internal server error', details: err.message }),
      { status: 500, headers: { 'Content-Type': 'application/json' } }
    );
  }
};

serve(handler);
